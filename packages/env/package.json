{
  "name": "@konfig.ts/env",
  "version": "0.4.0",
  "description": "Yieldable environment atoms (defineSecret, defineLiteral, defineDownward, defineEnvironment) shared between konfig manifest emission and the runtime pod application.",
  "license": "MIT",
  "author": "David Stahl-Gruber",
  "homepage": "https://dwiedave.github.io/konfig.ts/",
  "bugs": "https://github.com/DwieDave/konfig.ts/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DwieDave/konfig.ts.git",
    "directory": "packages/env"
  },
  "keywords": [
    "kubernetes",
    "k8s",
    "config",
    "secret",
    "effect",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs"
      }
    }
  },
  "scripts": {
    "build": "bun ../../scripts/cli.ts pkg build",
    "check": "bun ../../scripts/cli.ts pkg check",
    "test": "bun ../../scripts/cli.ts pkg test",
    "lint": "bun ../../scripts/cli.ts pkg lint",
    "lint:apply": "oxlint --fix",
    "prepublishOnly": "bun run build",
    "prepack": "bun ../../scripts/cli.ts pkg prepack",
    "postpack": "bun ../../scripts/cli.ts pkg postpack",
    "test:coverage": "bun ../../scripts/cli.ts pkg test:coverage"
  },
  "dependencies": {
    "@konfig.ts/core": "workspace:*"
  },
  "peerDependencies": {
    "effect": "^4.1.0"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/bun": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "effect": "catalog:",
    "fast-check": "catalog:",
    "vitest": "catalog:"
  }
}
