{
	"name": "@konfig.ts/env",
	"version": "0.0.11",
	"description": "Yieldable environment atoms (defineSecret, defineLiteral, defineDownward, defineEnvironment) shared between konfig manifest emission and the runtime pod application.",
	"license": "MIT",
	"author": "David Stahl-Gruber",
	"homepage": "https://dwiedave.github.io/konfig.ts/",
	"bugs": "https://github.com/DwieDave/konfig.ts/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/DwieDave/konfig.ts.git",
		"directory": "packages/env"
	},
	"keywords": [
		"kubernetes",
		"k8s",
		"config",
		"secret",
		"effect",
		"typescript"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"bun": "./src/index.ts",
			"source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"node": ">=22"
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.mjs"
			}
		}
	},
	"scripts": {
		"build": "tsdown ./src/index.ts --format=esm --target=node22 --sourcemap --clean --no-dts && tsc -p tsconfig.build.json",
		"check": "tsc -p tsconfig.check.json --noEmit",
		"test": "vitest run",
		"lint": "oxlint",
		"lint:apply": "oxlint --fix",
		"prepublishOnly": "bun run build",
		"prepack": "bun ../../scripts/cli.ts prepack-exports strip",
		"postpack": "bun ../../scripts/cli.ts prepack-exports restore",
		"test:coverage": "vitest run --coverage --reporter=default --reporter=json --outputFile=./coverage/test-results.json"
	},
	"dependencies": {
		"@konfig.ts/core": "0.0.11"
	},
	"peerDependencies": {
		"effect": "^4.0.0-rc.111"
	},
	"devDependencies": {
		"@effect/vitest": "^4.0.0-rc.111",
		"@types/bun": "^1.3.14",
		"@vitest/coverage-v8": "^4.1.10",
		"effect": "^4.0.0-rc.111",
		"fast-check": "^4.9.0",
		"vitest": "^4.1.10"
	}
}
