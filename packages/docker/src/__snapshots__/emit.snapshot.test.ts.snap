exports[`emit snapshots — production spec (prod-deps stage) > npm > npm-production-Dockerfile 1`] = `
"# konfig-managed: @konfig.ts/docker
# spec: packages/app/docker.ts
# hash: sha256:75a2f985fb81673fa4b2cd500b89004c79e7ba124c4bbaf5dcf585a1959e344a
FROM node:22-alpine AS base

FROM base AS deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/app/package.json ./packages/app/
COPY packages/other/package.json ./packages/other/
COPY packages/shared/package.json ./packages/shared/
COPY packages/util/package.json ./packages/util/
RUN npm ci --ignore-scripts

FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules /app/node_modules
COPY --from=deps /app/packages/shared/node_modules /app/packages/shared/node_modules
COPY --from=deps /app/packages/util/node_modules /app/packages/util/node_modules
COPY --from=deps /app/packages/app/node_modules /app/packages/app/node_modules
COPY packages/shared ./packages/shared
COPY packages/util ./packages/util
COPY packages/app ./packages/app
WORKDIR /app/packages/app
RUN npm run build

FROM base AS prod-deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN node -e 'const fs=require("fs"); const p=JSON.parse(fs.readFileSync("package.json","utf-8")); p.workspaces=["packages/app","packages/shared","packages/util"]; delete p.devDependencies; fs.writeFileSync("package.json", JSON.stringify(p,null,2));'
COPY packages/shared/package.json ./packages/shared/
COPY packages/util/package.json ./packages/util/
COPY packages/app/package.json ./packages/app/
RUN npm install --ignore-scripts --omit=dev

FROM base AS runner
WORKDIR /app/packages/app
RUN addgroup -S -g 1001 app && adduser -S -u 1001 -G app app
ENV NODE_ENV=production
COPY --from=builder --chown=app:app /app/packages/app/dist /app/packages/app/dist
USER app
CMD ["bun","run","dist/main.js"]
"
`;

