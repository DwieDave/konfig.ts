"# konfig-managed: @konfig.ts/docker
# spec: packages/app/docker.ts
# hash: sha256:fee983cb3cf252e38ec7a7370c2bbe521ce108fdcfb3afee9b591d7e6f38d789
FROM node:22-alpine AS base

FROM base AS deps
WORKDIR /app
COPY package.json yarn.lock .yarnrc.yml ./
COPY packages/app/package.json ./packages/app/
COPY packages/shared/package.json ./packages/shared/
COPY packages/util/package.json ./packages/util/
RUN corepack enable yarn && corepack prepare yarn@4.5.0 --activate
RUN YARN_ENABLE_SCRIPTS=false yarn install --immutable

FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules /app/node_modules
COPY packages/shared ./packages/shared
COPY packages/util ./packages/util
COPY packages/app ./packages/app
WORKDIR /app/packages/app
RUN yarn run build

FROM base AS prod-deps
WORKDIR /app
COPY package.json yarn.lock .yarnrc.yml ./
COPY packages/app/package.json ./packages/app/
COPY packages/shared/package.json ./packages/shared/
COPY packages/util/package.json ./packages/util/
RUN corepack enable yarn && corepack prepare yarn@4.5.0 --activate
RUN YARN_ENABLE_SCRIPTS=false yarn workspaces focus --production @fix/app

FROM base AS runner
WORKDIR /app/packages/app
RUN addgroup -S -g 1001 app && adduser -S -u 1001 -G app app
ENV NODE_ENV=production
COPY --from=builder --chown=app:app /app/packages/app/dist /app/packages/app/dist
USER app
CMD ["bun","run","dist/main.js"]
"
`;

