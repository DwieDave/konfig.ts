{
  "name": "fix-npm-root",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "fix-npm-root",
      "workspaces": [
        "packages/*"
      ]
    },
    "node_modules/@fix/app": {
      "resolved": "packages/app",
      "link": true
    },
    "node_modules/@fix/other": {
      "resolved": "packages/other",
      "link": true
    },
    "node_modules/@fix/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "node_modules/@fix/util": {
      "resolved": "packages/util",
      "link": true
    },
    "packages/app": {
      "name": "@fix/app",
      "version": "0.0.0",
      "dependencies": {
        "@fix/util": "^0.0.0"
      },
      "engines": {
        "node": "22",
        "npm": "10.5.0"
      }
    },
    "packages/other": {
      "name": "@fix/other",
      "version": "0.0.0"
    },
    "packages/shared": {
      "name": "@fix/shared",
      "version": "0.0.0"
    },
    "packages/util": {
      "name": "@fix/util",
      "version": "0.0.0",
      "dependencies": {
        "@fix/shared": "^0.0.0"
      }
    }
  }
}
