{
  "name": "konfig.ts",
  "version": "0.4.0",
  "private": true,
  "description": "Typesafe Kubernetes + ArgoCD configuration in TypeScript, powered by Effect.",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples",
    "examples/full-stack",
    "examples/full-stack/apps/*",
    "examples/full-stack/shared/*"
  ],
  "catalog": {
    "@effect/platform-node": "4.1.0",
    "@effect/vitest": "4.1.0",
    "@types/bun": "^1.3.14",
    "@vitest/coverage-v8": "^5.0.5",
    "effect": "4.1.0",
    "fast-check": "^4.9.0",
    "vitest": "^5.0.5",
    "yaml": "^2.9.0"
  },
  "scripts": {
    "konfig": "bun packages/cli/src/main.ts",
    "build": "bun scripts/cli.ts build",
    "check": "bun scripts/cli.ts check && bun run --cwd examples check && bun run --cwd examples/full-stack check && bun run --cwd apps/website check && tsc -p scripts/tsconfig.json --noEmit",
    "test": "bun scripts/cli.ts test",
    "lint": "oxlint --report-unused-disable-directives",
    "lint:apply": "oxlint --fix",
    "knip": "knip",
    "prepare": "effect-tsgo patch --no-typescript --oxlint",
    "test:coverage": "bun scripts/cli.ts coverage && bun scripts/cli.ts badges",
    "repo": "bun scripts/cli.ts"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/tsgo": "0.53.4",
    "@oxlint/plugins": "1.88.0",
    "effect": "catalog:",
    "fast-check": "catalog:",
    "knip": "^6.32.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "catalog:"
  }
}
