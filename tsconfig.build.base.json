{
  "compilerOptions": {
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": false,
    "composite": false,
    "incremental": false,
    "declarationDir": "${configDir}/dist",
    "rootDir": "${configDir}/src"
  },
  "include": [
    "${configDir}/src/**/*.ts",
    "${configDir}/src/.generated/**/*.ts"
  ],
  "exclude": [
    "${configDir}/node_modules/**/*",
    "${configDir}/dist/**/*",
    "${configDir}/src/**/*.test.ts"
  ]
}
