---
import { ArrowUpRight, Menu, X } from "@lucide/astro"
import SearchDialog from "@/components/navigation/SearchDialog.astro"
import Wordmark from "@/components/Wordmark.astro"
import { SITE, base } from "@/lib/site"

interface Props {
  readonly active?: "home" | "docs" | undefined
}

const { active = "home" } = Astro.props
const home = `${base}/`
const LINKS = [
  { id: "docs", label: "Docs", href: `${base}/docs/getting-started/introduction/` },
  { id: "why", label: "Why", href: `${home}#break-it` },
  { id: "features", label: "Features", href: `${home}#catches` },
  { id: "packages", label: "Packages", href: `${home}#packages` },
  { id: "faq", label: "FAQ", href: `${home}#faq` }
] as const

const linkClass = "text-sm font-medium text-zinc-400 no-underline transition-colors hover:text-white"
const activeClass = "text-white"
---

<div class="sticky top-0 z-100 w-full">
  <div class="w-full border-b border-zinc-800 bg-zinc-950">
    <header class="relative mx-auto w-full max-w-352 px-4">
      <nav class="flex h-16 items-center" aria-label="Main">
        <a href={home} class="flex items-center no-underline" aria-label="konfig.ts home">
          <Wordmark class="text-lg" />
        </a>

        <div class="ml-8 hidden items-center gap-6 md:flex">
          {
            LINKS.map((l) => (
              <a href={l.href} class:list={[linkClass, l.id === active && activeClass]} aria-current={l.id === active ? "page" : undefined}>
                {l.label}
              </a>
            ))
          }
        </div>

        <div class="ml-auto hidden items-center gap-4.5 md:flex">
          <SearchDialog />
          <a href={SITE.npm} target="_blank" rel="noopener noreferrer" class:list={[linkClass, "inline-flex items-center gap-1"]}>
            npm <ArrowUpRight size={14} aria-hidden="true" />
          </a>
          <a
            href={SITE.repo}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-md border border-zinc-700 bg-zinc-900 px-3 py-1.5 text-sm font-medium text-white no-underline transition-colors hover:border-zinc-500 hover:bg-zinc-800"
          >
            <svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true">
              <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2.17c-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.24 2.76.12 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.7 5.39-5.27 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"></path>
            </svg>
            GitHub
          </a>
        </div>

        <konfig-mobile-menu class="ml-auto md:hidden">
          <button
            type="button"
            data-role="toggle"
            aria-expanded="false"
            aria-controls="mobile-menu"
            aria-label="Open menu"
            class="flex size-9 items-center justify-center rounded-md border border-zinc-800 text-zinc-300 hover:bg-zinc-900 hover:text-white"
          >
            <Menu data-role="icon-open" size={18} aria-hidden="true" />
            <X data-role="icon-close" size={18} class="hidden" aria-hidden="true" />
          </button>
          <div
            id="mobile-menu"
            data-role="panel"
            hidden
            class="absolute inset-x-0 top-16 border-b border-zinc-800 bg-zinc-950 px-4 py-4"
          >
            <ul class="flex flex-col gap-1">
              {
                LINKS.map((l) => (
                  <li>
                    <a href={l.href} class="block rounded-md px-3 py-2 text-base font-medium text-zinc-300 no-underline hover:bg-zinc-900 hover:text-white">
                      {l.label}
                    </a>
                  </li>
                ))
              }
              <li class="mt-2 border-t border-dashed border-zinc-800 pt-3">
                <a href={SITE.repo} class="block rounded-md px-3 py-2 text-base font-medium text-zinc-300 no-underline hover:bg-zinc-900 hover:text-white">GitHub</a>
              </li>
              <li>
                <a href={SITE.npm} class="block rounded-md px-3 py-2 text-base font-medium text-zinc-300 no-underline hover:bg-zinc-900 hover:text-white">npm</a>
              </li>
            </ul>
          </div>
        </konfig-mobile-menu>
      </nav>
    </header>
  </div>
</div>

<script>
  class KonfigMobileMenu extends HTMLElement {
    #open = false
    connectedCallback() {
      const toggle = this.querySelector("[data-role='toggle']")
      const panel = this.querySelector("[data-role='panel']")
      const iconOpen = this.querySelector("[data-role='icon-open']")
      const iconClose = this.querySelector("[data-role='icon-close']")
      if (!(toggle instanceof HTMLButtonElement) || !(panel instanceof HTMLElement)) return
      const set = (open: boolean) => {
        this.#open = open
        panel.hidden = !open
        toggle.setAttribute("aria-expanded", String(open))
        toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu")
        iconOpen?.classList.toggle("hidden", open)
        iconClose?.classList.toggle("hidden", !open)
      }
      toggle.addEventListener("click", () => set(!this.#open))
      panel.addEventListener("click", (e) => {
        if (e.target instanceof HTMLAnchorElement) set(false)
      })
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") set(false)
      })
    }
  }
  if (!customElements.get("konfig-mobile-menu")) customElements.define("konfig-mobile-menu", KonfigMobileMenu)
</script>
