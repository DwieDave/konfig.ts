---
import CodeBlock from "@/components/ui/CodeBlock.astro"
import Eyebrow from "@/components/ui/Eyebrow.astro"

const STEPS = [
  {
    cmd: "konfig build prod",
    title: "Render",
    body: "Loads infra/env/prod.ts, resolves the dep graph, writes one directory per Application. Builds are input-hashed: a no-op build rewrites nothing, so Argo CD sees no churn."
  },
  {
    cmd: "konfig validate prod --strict",
    title: "Validate",
    body: "Renders in memory and runs structural checks; --strict hands every document to kubeconform against the pinned --k8s-version."
  },
  {
    cmd: "konfig diff prod",
    title: "Diff",
    body: "Structural multi-document diff against the committed baseline. Key reordering is invisible; Secret data is redacted before it hits your terminal."
  },
  {
    cmd: "konfig set prod api ghcr.io/example/api:1.2.0",
    title: "Promote",
    body: "Rewrites images.json (schema-validated before and after) so image promotion is a one-line commit that re-renders deterministically."
  }
] as const

const OTHERS = [
  {
    cmd: "konfig docker write apps/api",
    out: "apps/api/Dockerfile",
    what: "Multi-stage Dockerfile derived from the workspace graph: only the packages apps/api actually imports make it into the build context."
  },
  {
    cmd: "konfig crd extract | verify",
    out: "types/crds.d.ts",
    what: "TypeScript types generated from the CRDs in your Helm charts; verify fails the build when the chart's CRDs drift from the committed types."
  },
  {
    cmd: "konfig helm fetch --all",
    out: ".helm-cache/",
    what: "Warms the chart cache for every pinned chart and checks each archive against its recorded digest before anything renders."
  },
  {
    cmd: "konfig graph --with-dev",
    out: "stdout",
    what: "ASCII workspace dependency graph, dev dependencies included — the same graph build and docker write use."
  }
] as const

const SHELL = STEPS.map((s) => `$ ${s.cmd}`).join("\n")
---

<section id="workflow" class="relative w-full overflow-hidden py-24 md:pt-40 md:pb-24">
  <div class="absolute inset-0 bg-linear-to-b from-zinc-950/0 via-zinc-950/0 to-zinc-900/50" aria-hidden="true"></div>
  <div class="relative mx-auto w-full max-w-295">
    <div class="mb-12 grid grid-cols-1 gap-8 px-4 lg:grid-cols-2 lg:items-center">
      <div>
        <Eyebrow>The workflow</Eyebrow>
        <h2 class="max-w-2xl text-2xl leading-tighter font-semibold text-white md:text-3xl">Four commands from source to a clean Argo CD sync</h2>
        <p class="mt-4 max-w-lg text-lg leading-snug text-zinc-400">
          konfig emits manifests; Argo CD applies them. There's no operator, no admission controller, nothing running in the cluster.
        </p>
      </div>
      <div class="min-w-0">
        <CodeBlock code={SHELL} lang="bash" title="zsh" lineNumbers={false} />
      </div>
    </div>

    <div class="px-4">
      <ol class="m-0 grid list-none grid-cols-1 gap-6 p-0 md:grid-cols-4">
        {
          STEPS.map((s, i) => (
            <li class="flex flex-col gap-2">
              <span class="font-mono text-sm text-zinc-400">0{i + 1}</span>
              <p class="text-base leading-relaxed text-zinc-400">
                <span class="font-medium text-white">{s.title}: </span>
                {s.body}
              </p>
            </li>
          ))
        }
      </ol>

      <div class="mt-16 border-t border-dashed border-zinc-800 pt-8">
        <div class="mb-6 flex items-baseline justify-between gap-4">
          <p class="font-mono text-xs tracking-wider text-zinc-500 uppercase">Also in the box</p>
          <p class="hidden font-mono text-xs text-zinc-600 md:block">$ konfig --help</p>
        </div>
        <ul class="m-0 grid list-none grid-cols-1 gap-4 p-0 md:grid-cols-2 xl:grid-cols-4">
          {
            OTHERS.map((o) => (
              <li class="also-card group relative flex flex-col gap-3 rounded-lg border border-zinc-800 bg-zinc-950/60 p-4 transition-colors hover:border-zinc-600">
                <p class="m-0 font-mono text-sm leading-snug">
                  <span class="text-emerald-400 select-none">$ </span>
                  <span class="text-white">{o.cmd}</span>
                  <span class="also-caret ml-0.5 inline-block h-[1em] w-[0.5em] translate-y-[0.15em] bg-zinc-500 opacity-0" aria-hidden="true" />
                </p>
                <p class="m-0 font-mono text-xs text-zinc-500">
                  <span class="text-zinc-600 select-none">→ </span>{o.out}
                </p>
                <p class="m-0 mt-auto text-sm leading-relaxed text-zinc-400">{o.what}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  /* Blinking caret only while the card is hovered: it reads as "your turn". */
  @keyframes also-blink {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .also-card:hover .also-caret {
      animation: also-blink 1s steps(1) infinite;
    }
  }
</style>
