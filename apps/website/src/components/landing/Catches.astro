---
import { ArrowDown, Check, ShieldCheck, GitBranch, KeyRound, Link2, Network, Rows3 } from "@lucide/astro"
import Eyebrow from "@/components/ui/Eyebrow.astro"

type Icon = "refs" | "deps" | "env" | "secrets" | "helm" | "yaml"

interface Feature {
  readonly problem: string
  readonly icon: Icon
  readonly title: string
  readonly items: ReadonlyArray<string>
}

const FEATURES: ReadonlyArray<Feature> = [
  {
    problem: "A Secret nobody created. You find out from the pod events.",
    icon: "refs",
    title: "Branded refs",
    items: ["Secret.make(...).ref, not a string", "Wrong namespace won't compile", "Typo'd port names won't compile"]
  },
  {
    problem: "A dependency on another Application. You find out at sync time.",
    icon: "deps",
    title: "Dep graph at the type level",
    items: ["yield* Dep.Secret(\"…\") records a Need", "entrypoint requires every Need to be provided", "Duplicate App names are rejected"]
  },
  {
    problem: "App reads DATABASE_URL, Deployment sets DB_URL.",
    icon: "env",
    title: "Env contracts",
    items: ["One Environment.define, both sides", "Missing secret binding won't compile", "Env-name collisions won't compile"]
  },
  {
    problem: "A plaintext value in the sops file. It is in git now.",
    icon: "secrets",
    title: "Secret backends",
    items: ["sops · sealed-secrets · external-secrets", "requiresSource is in the backend's type", "sops fails closed on plaintext"]
  },
  {
    problem: "Pinned by version; the tarball changed anyway.",
    icon: "helm",
    title: "Helm with digest verification",
    items: ["Digest checked on pull and cache hit", "Flip a byte, fail the next render", "Charts stay charts"]
  },
  {
    problem: "A 400-line diff, 396 lines of reordering.",
    icon: "yaml",
    title: "Deterministic YAML, structural diff",
    items: ["Stable key order, Argo-friendly", "konfig diff ignores reordering", "No-op builds rewrite nothing"]
  }
]
---

<section id="catches" class="relative w-full py-24 md:pt-40 md:pb-24">
  <div class="relative mx-auto w-full max-w-295 px-4">
    <div class="mb-8 md:mb-16">
      <Eyebrow>What konfig.ts catches</Eyebrow>
      <h2 class="max-w-md text-2xl leading-tighter font-semibold text-white md:text-3xl">
        The failure modes of YAML, moved to compile time
      </h2>
    </div>

    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {
        FEATURES.map((f) => (
          <article class="flex flex-col border border-zinc-800 bg-zinc-950 p-5">
            <p class="text-base leading-snug font-medium text-zinc-400">{f.problem}</p>
            <div class="my-4 flex items-center gap-2">
              <div class="h-px flex-1 bg-zinc-800" />
              <ArrowDown class="h-4 w-4 text-white" aria-hidden="true" />
              <div class="h-px flex-1 bg-zinc-800" />
            </div>
            <h3 class="flex items-center gap-2 font-mono text-base font-medium text-white uppercase">
              <span class="flex h-6 w-6 shrink-0 items-center justify-center bg-zinc-800">
                {f.icon === "refs" ? (
                  <Link2 class="h-4 w-4 text-zinc-200" aria-hidden="true" />
                ) : f.icon === "deps" ? (
                  <Network class="h-4 w-4 text-zinc-200" aria-hidden="true" />
                ) : f.icon === "env" ? (
                  <GitBranch class="h-4 w-4 text-zinc-200" aria-hidden="true" />
                ) : f.icon === "secrets" ? (
                  <KeyRound class="h-4 w-4 text-zinc-200" aria-hidden="true" />
                ) : f.icon === "helm" ? (
                  <ShieldCheck class="h-4 w-4 text-zinc-200" aria-hidden="true" />
                ) : (
                  <Rows3 class="h-4 w-4 text-zinc-200" aria-hidden="true" />
                )}
              </span>
              {f.title}
            </h3>
            <ul class="m-0 mt-3 flex list-none flex-col gap-1.5 p-0">
              {f.items.map((item) => (
                <li class="flex items-start gap-2">
                  <span class="flex h-6 w-6 shrink-0 items-center justify-center">
                    <Check class="h-4 w-4 text-emerald-500" aria-hidden="true" />
                  </span>
                  <span class="text-sm text-zinc-400">{item}</span>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>
