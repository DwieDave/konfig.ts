---
import { ArrowDown, Check } from "@lucide/astro"
import CodeBlock from "@/components/ui/CodeBlock.astro"
import Eyebrow from "@/components/ui/Eyebrow.astro"
import { SNIPPETS, load } from "@/lib/catalog"

const contract = load(SNIPPETS.envContract)
const secrets = load(SNIPPETS.envSecrets)
const bind = load(SNIPPETS.envBind)
const runtimeImports = load(SNIPPETS.envRuntimeImports)
const runtimeUse = load(SNIPPETS.envRuntimeUse)
const runtime = {
  code: [
    runtimeImports.code,
    'import { Effect } from "effect"',
    "",
    "const config = await Effect.runPromise(",
    "  Environment.runtime(apiEnv) // … error handling elided …",
    ")",
    "",
    runtimeUse.code
  ].join("\n")
}

const STEPS = [
  {
    id: "declare",
    title: "Declare the contract once",
    body: "Secrets, literals and downward-API fields become one typed value that both sides import.",
    reveal: "Bind it in a module"
  },
  {
    id: "bind",
    title: "Bind it in the infra module",
    body: "Environment.bind emits the Deployment env block plus the secret backend's CRs. A member without a backend does not compile.",
    reveal: "Decode it at runtime"
  },
  {
    id: "runtime",
    title: "Decode it in the process",
    body: "Environment.runtime reads the same variables at startup into a typed record. Secrets arrive Redacted.",
    reveal: undefined
  }
] as const
---

<section id="both-sides" class="relative w-full py-24 md:pt-40 md:pb-24">
  <konfig-steps class="mx-auto block w-full max-w-295 px-4">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] md:gap-12">
      <div>
        <Eyebrow>One source, both sides of the wire</Eyebrow>
        <h2 class="max-w-lg text-2xl leading-tighter font-semibold text-white md:text-3xl">
          Declare the env contract once. The pod spec and the process both import it.
        </h2>
        <p class="mt-4 max-w-lg text-lg text-zinc-400">
          Rename <code class="font-mono text-base text-zinc-200">DATABASE_URL</code> in one place and the typechecker flags every consumer.
        </p>

        <ol class="m-0 mt-8 flex list-none flex-col gap-3 p-0">
          {
            STEPS.map((s, i) => (
              <li
                data-step-item={s.id}
                class:list={[
                  "step-item rounded-md border p-4 transition-all",
                  i === 0 ? "border-zinc-700 bg-zinc-900/40" : "step-item--pending border-zinc-800 bg-transparent"
                ]}
              >
                <div class="flex items-start gap-3" data-goto={s.id}>
                  <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-zinc-800 font-mono text-xs font-semibold text-zinc-200">
                    0{i + 1}
                  </span>
                  <div class="min-w-0 flex-1">
                    <h3 class="text-base font-semibold text-white">{s.title}</h3>
                    <p class="mt-1 text-sm leading-relaxed text-zinc-400">{s.body}</p>
                    {
                      s.reveal !== undefined && (
                        <button
                          type="button"
                          data-reveal={STEPS[i + 1]?.id}
                          aria-controls={`step-${STEPS[i + 1]?.id}`}
                          aria-expanded="false"
                          class:list={[
                            i === 0 ? "" : "step-button--pending",
                            "mt-3 inline-flex items-center gap-2 rounded-md border border-zinc-700 bg-zinc-900 px-3 py-1.5 text-sm font-medium text-white transition-colors hover:border-zinc-500 hover:bg-zinc-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-zinc-300"
                          ]}
                        >
                          <ArrowDown size={14} aria-hidden="true" />
                          Next: {s.reveal}
                        </button>
                      )
                    }
                  </div>
                </div>
              </li>
            ))
          }
        </ol>

        <ul class="m-0 mt-6 list-none space-y-2 p-0">
          <li class="flex items-center gap-2 text-sm text-zinc-400">
            <Check class="h-4 w-4 shrink-0 text-emerald-500" aria-hidden="true" />
            <span>Missing secret binding: compile error</span>
          </li>
          <li class="flex items-center gap-2 text-sm text-zinc-400">
            <Check class="h-4 w-4 shrink-0 text-emerald-500" aria-hidden="true" />
            <span>Env-name collision between members: compile error</span>
          </li>
        </ul>
      </div>

      <div class="step-stage grid min-w-0">
        <div id="step-declare" data-step="declare" data-active class="step-panel flex flex-col gap-3">
          <p class="font-mono text-xs tracking-wider text-zinc-500 uppercase"><span class="text-zinc-300">01</span> · shared/env-contracts</p>
          <CodeBlock code={secrets.code} lang="ts" title="shared/env-contracts/src/secrets.ts" />
          <CodeBlock code={contract.code} lang="ts" title="shared/env-contracts/src/bundles.ts" />
        </div>
        <div id="step-bind" data-step="bind" class="step-panel flex flex-col gap-3">
          <p class="font-mono text-xs tracking-wider text-zinc-500 uppercase"><span class="text-zinc-300">02</span> · manifest side · <span class="text-zinc-300">Environment.bind</span></p>
          <CodeBlock code={bind.code} lang="ts" title="infra/modules/api.ts" />
        </div>
        <div id="step-runtime" data-step="runtime" class="step-panel flex flex-col gap-3">
          <p class="font-mono text-xs tracking-wider text-zinc-500 uppercase"><span class="text-zinc-300">03</span> · process side · <span class="text-zinc-300">Environment.runtime</span></p>
          <CodeBlock code={runtime.code} lang="ts" title="apps/api/src/main.ts" />
        </div>
      </div>
    </div>
  </konfig-steps>
</section>

<style>
  /* Without JS every panel renders stacked. With JS the stage stacks them in one
     grid cell (sized to the tallest), so switching steps never changes height. */
  konfig-steps[data-js] .step-stage {
    grid-template-areas: "panel";
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
  }
  konfig-steps[data-js] .step-panel {
    grid-area: panel;
    min-width: 0;
    width: 100%;
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition:
      opacity 280ms ease,
      transform 280ms ease,
      visibility 0s linear 280ms;
  }
  konfig-steps[data-js] .step-panel[data-active] {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition:
      opacity 280ms ease,
      transform 280ms ease,
      visibility 0s;
  }
  konfig-steps[data-js] .step-item--pending {
    opacity: 0.55;
  }
  konfig-steps[data-js] .step-item:not(.step-item--pending) [data-goto] {
    cursor: pointer;
  }
  konfig-steps[data-js] .step-button--pending {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    konfig-steps[data-js] .step-panel {
      transition: none;
    }
  }
</style>

<script>
  // Progressive reveal: without JS every step is visible; with JS the stage
  // shows one step at a time. "Next" unlocks and shows the following step;
  // unlocked step cards can be clicked to switch back and forth.
  class KonfigSteps extends HTMLElement {
    connectedCallback() {
      const panels = Array.from(this.querySelectorAll("[data-step]")).filter((el): el is HTMLElement => el instanceof HTMLElement)
      const items = Array.from(this.querySelectorAll("[data-step-item]")).filter((el): el is HTMLElement => el instanceof HTMLElement)
      const buttons = Array.from(this.querySelectorAll("[data-reveal]")).filter((el): el is HTMLButtonElement => el instanceof HTMLButtonElement)
      this.setAttribute("data-js", "")
      const unlocked = new Set<string>([panels[0]?.dataset["step"] ?? ""])

      const show = (id: string) => {
        for (const p of panels) {
          if (p.dataset["step"] === id) p.setAttribute("data-active", "")
          else p.removeAttribute("data-active")
        }
        for (const i of items) {
          const active = i.dataset["stepItem"] === id
          i.classList.toggle("border-zinc-700", active)
          i.classList.toggle("bg-zinc-900/40", active)
          i.classList.toggle("border-zinc-800", !active)
          i.classList.toggle("bg-transparent", !active)
          i.setAttribute("aria-current", active ? "step" : "false")
        }
      }

      const unlock = (id: string) => {
        unlocked.add(id)
        const item = items.find((i) => i.dataset["stepItem"] === id)
        item?.classList.remove("step-item--pending")
        item?.querySelector(".step-button--pending")?.classList.remove("step-button--pending")
      }

      for (const button of buttons) {
        button.addEventListener("click", (e) => {
          e.stopPropagation()
          const id = button.dataset["reveal"]
          if (id === undefined) return
          unlock(id)
          show(id)
          button.setAttribute("aria-expanded", "true")
        })
      }
      for (const item of items) {
        const id = item.dataset["stepItem"]
        const header = item.querySelector("[data-goto]")
        if (id === undefined || !(header instanceof HTMLElement)) continue
        header.addEventListener("click", () => {
          if (unlocked.has(id)) show(id)
        })
      }
      show(panels[0]?.dataset["step"] ?? "")
    }
  }
  if (!customElements.get("konfig-steps")) customElements.define("konfig-steps", KonfigSteps)
</script>
