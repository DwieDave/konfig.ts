---
import { ArrowRight, ArrowUpRight } from "@lucide/astro"
import GridBackground from "@/components/GridBackground.astro"
import GridInteractive from "@/components/GridInteractive.astro"
import Button from "@/components/ui/Button.astro"
import InstallPanel from "@/components/ui/InstallPanel.astro"
import { SITE, base } from "@/lib/site"
---

<section class="relative w-full py-36 md:py-24">
  <GridBackground />
  <GridInteractive />
  <div class="relative mx-auto w-full max-w-295 px-4">
    <div data-grid-content class="flex flex-col items-center text-center">
      <p class="mb-3 font-mono text-base text-zinc-500">
        <span>import {"{ "}</span><span class="text-white">AppOfApps</span><span>{" }"} from "@konfig.ts/argocd"</span>
      </p>
      <h2 class="max-w-3xl text-4xl leading-tighter font-bold text-white">
        Stop finding out at sync time
      </h2>
      <div class="mx-auto mt-8 w-full max-w-xl">
        <InstallPanel />
      </div>
      <div class="mt-6 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <Button href={`${SITE.repo}#readme`} external size="md" variant="primary">
          Read the README
          <ArrowRight class="size-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
        </Button>
        <Button href={SITE.example} external size="md">
          Full-stack example
          <ArrowUpRight class="size-4 text-zinc-500 transition-colors group-hover:text-white" aria-hidden="true" />
        </Button>
      </div>
    </div>
  </div>
</section>
