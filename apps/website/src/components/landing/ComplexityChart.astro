<konfig-complexity-chart class="block w-full" data-in-view="false">
  <div class="relative h-36 w-full overflow-hidden md:h-44">
    <svg
      role="img"
      aria-labelledby="complexity-chart-title complexity-chart-description"
      viewBox="0 0 400 140"
      class="h-full w-full"
      preserveAspectRatio="none"
    >
      <title id="complexity-chart-title">Things that can go wrong, per app added</title>
      <desc id="complexity-chart-description">A chart comparing how many manifest mistakes reach the cluster with hand-written YAML versus konfig.ts, as the number of apps grows.</desc>
      <defs>
        <linearGradient id="chart-red" x1="0%" y1="0%" x2="0%" y2="100%">
          <stop offset="0%" stop-color="rgb(239 68 68)" stop-opacity="0.12"></stop>
          <stop offset="100%" stop-color="rgb(239 68 68)" stop-opacity="0"></stop>
        </linearGradient>
        <linearGradient id="chart-green" x1="0%" y1="0%" x2="0%" y2="100%">
          <stop offset="0%" stop-color="rgb(16 185 129)" stop-opacity="0.08"></stop>
          <stop offset="100%" stop-color="rgb(16 185 129)" stop-opacity="0"></stop>
        </linearGradient>
      </defs>
      {[0, 35, 70, 105, 140].map((y) => <line x1="0" y1={y} x2="400" y2={y} stroke="rgb(39 39 42 / 0.5)" stroke-width="0.8" />)}
      {[100, 200, 300].map((x) => <line x1={x} y1="0" x2={x} y2="140" stroke="rgb(39 39 42 / 0.35)" stroke-width="0.8" />)}
      <path class="chart-area" d="M0,118 C150,115 250,100 400,8 L400,140 L0,140 Z" fill="url(#chart-red)"></path>
      <path class="chart-area" d="M0,105 C50,105 90,105 125,105 C200,100 300,92 400,85 L400,140 L0,140 Z" fill="url(#chart-green)"></path>
      <path class="chart-line chart-line--red" d="M0,118 C150,115 250,100 400,8" fill="none" stroke="rgb(239 68 68)" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"></path>
      <path class="chart-line chart-line--green" d="M0,105 C50,105 90,105 125,105 C200,100 300,92 400,85" fill="none" stroke="rgb(16 185 129)" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke"></path>
    </svg>
    <div class="pointer-events-none absolute inset-x-0 top-0 flex justify-between px-1 font-mono text-[10px] tracking-wider text-zinc-500 uppercase">
      <span>mistakes reaching the cluster</span>
    </div>
  </div>
  <div class="mt-2 flex items-center justify-between font-mono text-[10px] tracking-wider text-zinc-500 uppercase">
    <span>apps →</span>
    <span class="flex items-center gap-4">
      <span class="inline-flex items-center gap-1.5"><span class="h-px w-4 bg-red-500"></span>hand-written yaml</span>
      <span class="inline-flex items-center gap-1.5"><span class="h-px w-4 bg-emerald-500"></span>konfig.ts</span>
    </span>
  </div>
</konfig-complexity-chart>

<style>
  .chart-line {
    stroke-dasharray: 1000;
    stroke-dashoffset: 1000;
  }
  .chart-area {
    opacity: 0;
    transition: opacity 600ms ease 900ms;
  }
  konfig-complexity-chart[data-in-view="true"] .chart-line {
    animation: draw 1400ms ease-out forwards;
  }
  konfig-complexity-chart[data-in-view="true"] .chart-line--green {
    animation-delay: 200ms;
  }
  konfig-complexity-chart[data-in-view="true"] .chart-area {
    opacity: 1;
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .chart-line {
      stroke-dashoffset: 0;
      animation: none !important;
    }
    .chart-area {
      opacity: 1;
      transition: none;
    }
  }
</style>

<script>
  class KonfigComplexityChart extends HTMLElement {
    connectedCallback() {
      if (!("IntersectionObserver" in window)) {
        this.dataset["inView"] = "true"
        return
      }
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              this.dataset["inView"] = "true"
              io.disconnect()
            }
          }
        },
        { threshold: 0.4 }
      )
      io.observe(this)
    }
  }
  if (!customElements.get("konfig-complexity-chart")) customElements.define("konfig-complexity-chart", KonfigComplexityChart)
</script>
