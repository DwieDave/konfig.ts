---
import { ArrowUpRight, Check } from "@lucide/astro"
import CodeBlock from "@/components/ui/CodeBlock.astro"
import Eyebrow from "@/components/ui/Eyebrow.astro"
import { SNIPPETS, load } from "@/lib/catalog"
import { SITE } from "@/lib/site"

const head = load(SNIPPETS.apiModuleHead)
const tail = load(SNIPPETS.apiModuleTail)
const api = {
  code: [head.code, "", "      // … Environment.bind + Container.define elided (see \"both sides\" above) …", "", tail.code].join("\n")
}
const prod = load(SNIPPETS.prodEnv)
---

<section id="mental-model" class="relative w-full overflow-hidden py-24 md:pt-40 md:pb-24">
  <div class="relative mx-auto w-full max-w-295 px-4">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2 md:gap-12">
      <div>
        <Eyebrow>The mental model</Eyebrow>
        <h2 class="max-w-lg text-2xl leading-tighter font-semibold text-white md:text-3xl">
          A module provides, needs, and emits — all three in its type
        </h2>
        <p class="mt-4 max-w-lg text-lg text-zinc-400">
          <code class="font-mono text-base text-zinc-200">Module.fixedNs</code> wraps a build function into an
          <code class="font-mono text-base text-zinc-200">Application</code> handle. Compose handles with
          <code class="font-mono text-base text-zinc-200">AppOfApps.fromModules</code>; the unmet Needs shrink as providers join the list, and
          <code class="font-mono text-base text-zinc-200">entrypoint</code> requires them to reach <code class="font-mono text-base text-zinc-200">never</code>.
        </p>
        <ul class="m-0 mt-5 list-none space-y-2 p-0">
          <li class="flex items-center gap-2 text-sm text-zinc-400">
            <Check class="h-4 w-4 shrink-0 text-emerald-500" aria-hidden="true" />
            <span>Builds are plain Effects — <code class="font-mono text-zinc-200">yield*</code> a dependency, return manifests</span>
          </li>
          <li class="flex items-center gap-2 text-sm text-zinc-400">
            <Check class="h-4 w-4 shrink-0 text-emerald-500" aria-hidden="true" />
            <span>Nothing hidden — the handle's type lists what it provides and what it still needs</span>
          </li>
          <li class="flex items-center gap-2 text-sm text-zinc-400">
            <Check class="h-4 w-4 shrink-0 text-emerald-500" aria-hidden="true" />
            <span>The env file's default export is what <code class="font-mono text-zinc-200">konfig build</code> renders</span>
          </li>
        </ul>

        <div class="mental-model-diagram mt-8 max-w-md">
          <div class="relative">
            <div aria-hidden="true" class="pointer-events-none absolute -inset-4 rounded-2xl opacity-30 blur-xl" style="background: radial-gradient(ellipse at center, rgb(255 255 255 / 0.2) 0%, transparent 70%);"></div>
            <div class="relative w-full border border-zinc-700 bg-zinc-900/50 px-6 py-4 text-center font-mono text-base">
              <span class="mental-model-type-line">
                <span class="text-white">ApplicationHandle</span><span class="text-zinc-500">&lt;</span><span data-part="name" class="mental-model-part text-sky-400">Name</span><span class="text-zinc-500">, </span><span data-part="provides" class="mental-model-part text-emerald-400">Provides</span><span class="text-zinc-500">, </span><span data-part="needs" class="mental-model-part text-violet-400">Needs</span><span class="text-zinc-500">&gt;</span>
              </span>
            </div>
            <svg class="mt-2 h-8 w-full" viewBox="0 0 400 32" fill="none" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
              <path d="M100 0 L100 16 L67 16 L67 32" stroke="rgb(113 113 122)" stroke-width="1" stroke-opacity="0.5"></path>
              <path d="M200 0 L200 32" stroke="rgb(113 113 122)" stroke-width="1" stroke-opacity="0.5"></path>
              <path d="M300 0 L300 16 L333 16 L333 32" stroke="rgb(113 113 122)" stroke-width="1" stroke-opacity="0.5"></path>
            </svg>
            <div class="grid grid-cols-3 gap-4 text-sm">
              <div data-part="name" class="mental-model-part text-center">
                <p class="font-medium text-zinc-200">Name</p>
                <p class="mt-1 text-xs text-zinc-400">A string literal, always</p>
              </div>
              <div data-part="provides" class="mental-model-part text-center">
                <p class="font-medium text-zinc-200">Provides</p>
                <p class="mt-1 text-xs text-zinc-400">Secrets, Images, Namespaces it emits</p>
              </div>
              <div data-part="needs" class="mental-model-part text-center">
                <p class="font-medium text-zinc-200">Needs</p>
                <p class="mt-1 text-xs text-zinc-400">What another module must provide</p>
              </div>
            </div>
          </div>
        </div>

        <div class="mt-6">
          <a
            href={`${SITE.repo}/tree/main/packages/argocd#internals`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-sm text-zinc-400 no-underline transition-colors hover:text-white"
          >
            How the algebra works
            <ArrowUpRight class="h-3.5 w-3.5" aria-hidden="true" />
          </a>
        </div>
      </div>

      <div class="flex min-w-0 flex-col gap-3">
        <CodeBlock code={api.code} lang="ts" title="infra/modules/api.ts" />
        <CodeBlock code={prod.code} lang="ts" title="infra/envs/prod.ts" />
      </div>
    </div>
  </div>
</section>

<style>
  .mental-model-part {
    transition: opacity 200ms ease;
  }
  .mental-model-type-line {
    display: inline;
    white-space: normal;
    overflow-wrap: anywhere;
    line-height: 1.25;
  }
  .mental-model-diagram:has([data-part="name"]:hover) [data-part]:not([data-part="name"]),
  .mental-model-diagram:has([data-part="provides"]:hover) [data-part]:not([data-part="provides"]),
  .mental-model-diagram:has([data-part="needs"]:hover) [data-part]:not([data-part="needs"]) {
    opacity: 0.45;
  }
</style>
