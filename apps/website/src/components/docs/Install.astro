---
import InstallPanel from "@/components/ui/InstallPanel.astro"

/** Install command panel for MDX: `<Install packages="@konfig.ts/core @konfig.ts/k8s" />`, `dev` for a dev dependency. */
interface Props {
  readonly packages: string
  readonly dev?: boolean | undefined
}

const { packages, dev = false } = Astro.props
---

<div class="not-prose my-4">
  <InstallPanel packages={packages} dev={dev} wrap />
</div>
