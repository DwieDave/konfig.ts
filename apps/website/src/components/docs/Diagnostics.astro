---
import CodeBlock from "@/components/ui/CodeBlock.astro"
import { FAILURE_CASES, load, type FailureCaseId } from "@/lib/catalog"

/** Renders one of the worked-failure cases with squiggles and hover diagnostics. */
interface Props {
  readonly case: FailureCaseId
}

const found = FAILURE_CASES.find((c) => c.id === Astro.props.case)
if (found === undefined) throw new Error(`Diagnostics: unknown case ${JSON.stringify(Astro.props.case)}`)
const snippet = load(found.spec)
---

<div class="not-prose my-6">
  <CodeBlock code={snippet.code} lang="ts" title={`examples/full-stack/${found.spec.file}`} diagnostics={snippet.diagnostics} />
  <div class="mt-3 overflow-x-auto rounded-md border border-zinc-800 bg-zinc-950 px-4 py-3 font-mono text-xs leading-relaxed">
    <span class="text-zinc-500">$ </span><span class="text-zinc-300">bun run check</span>
    <div class="mt-1 whitespace-pre-wrap text-red-400/90">{found.tsc}</div>
  </div>
</div>
