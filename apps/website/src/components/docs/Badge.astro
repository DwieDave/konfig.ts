---
interface Props {
  text: string
  variant?: "note" | "tip" | "danger" | "caution" | "success" | "default"
  size?: "small" | "medium" | "large"
}

const { text, variant = "default", size = "small" } = Astro.props
---

<span class={`badge badge--${variant} badge--${size}`}>{text}</span>

<style>
  .badge {
    display: inline-block;
    border-radius: 0.25rem;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
  }

  .badge--small {
    font-size: 0.75rem;
    padding: 0.2em 0.5em;
  }

  .badge--medium {
    font-size: 0.875rem;
    padding: 0.25em 0.625em;
  }

  .badge--large {
    font-size: 1rem;
    padding: 0.3em 0.75em;
  }

  .badge--default {
    background-color: rgb(39 39 42);
    color: rgb(228 228 231);
  }

  .badge--note {
    background-color: rgb(59 130 246 / 0.15);
    color: rgb(96 165 250);
  }

  .badge--tip {
    background-color: rgb(139 92 246 / 0.15);
    color: rgb(167 139 250);
  }

  .badge--danger {
    background-color: rgb(239 68 68 / 0.15);
    color: rgb(248 113 113);
  }

  .badge--caution {
    background-color: rgb(245 158 11 / 0.15);
    color: rgb(251 191 36);
  }

  .badge--success {
    background-color: rgb(16 185 129 / 0.15);
    color: rgb(52 211 153);
  }

  :global(.dark) .badge--default {
    background-color: rgb(63 63 70 / 0.5);
    color: #d4d4d8;
  }

  :global(.dark) .badge--note {
    background-color: rgb(30 58 138 / 0.3);
    color: #93c5fd;
  }

  :global(.dark) .badge--tip {
    background-color: rgb(88 28 135 / 0.3);
    color: #c4b5fd;
  }

  :global(.dark) .badge--danger {
    background-color: rgb(127 29 29 / 0.3);
    color: #fca5a5;
  }

  :global(.dark) .badge--caution {
    background-color: rgb(124 45 18 / 0.3);
    color: #fdba74;
  }

  :global(.dark) .badge--success {
    background-color: rgb(20 83 45 / 0.3);
    color: #86efac;
  }
</style>
