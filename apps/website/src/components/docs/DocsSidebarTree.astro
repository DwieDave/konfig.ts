---
import SidebarGroup from "@/components/ui/sidebar/SidebarGroup.astro"
import SidebarLink from "@/components/ui/sidebar/SidebarLink.astro"
import { entryHref, entryLabel, type DocEntry, type SidebarItem } from "@/lib/docs/sidebar"

interface Props {
  readonly items: ReadonlyArray<SidebarItem<DocEntry>>
  readonly currentId: string
}

const { items, currentId } = Astro.props
---

<ul class="flex flex-col gap-0.5">
  {
    items.map((item) =>
      item.kind === "entry" ? (
        <li>
          <SidebarLink
            href={entryHref(item.entry.id)}
            active={item.entry.id === currentId}
            class="-mx-2 flex items-center justify-between px-2 py-2.5 font-mono text-sm font-medium tracking-wider uppercase"
          >
            {entryLabel(item.entry)}
          </SidebarLink>
        </li>
      ) : (
        <li class="mb-1 last:mb-0">
          <SidebarGroup label={item.group.label} open={item.group.isOpen}>
            {item.group.entries.map((e) => (
              <li>
                <SidebarLink href={entryHref(e.id)} active={e.id === currentId} class="py-1.5 pl-3 text-sm">
                  {entryLabel(e)}
                </SidebarLink>
              </li>
            ))}
          </SidebarGroup>
        </li>
      )
    )
  }
</ul>
