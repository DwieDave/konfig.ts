---
interface Props {
  readonly href: string
  readonly external?: boolean | undefined
  readonly size?: "sm" | "md" | undefined
  readonly class?: string | undefined
}
const { href, external = false, size = "sm", class: className } = Astro.props
const sizeClass = size === "md" ? "rounded-md px-6 py-3 text-base bg-zinc-900/50" : "rounded-lg px-4 py-2 text-sm bg-zinc-900"
---

<a
  href={href}
  {...external ? { target: "_blank", rel: "noopener noreferrer" } : {}}
  class:list={[
    "group inline-flex items-center justify-center gap-2 border border-zinc-700 font-medium text-white no-underline transition-colors hover:border-zinc-500 hover:bg-zinc-800 hover:no-underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-zinc-300",
    sizeClass,
    className
  ]}
>
  <slot />
</a>
